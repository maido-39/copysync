# CopySync server — Docker config. Copy to `.env` and adjust; docker compose
# reads .env automatically. `.env` is gitignored (it may hold your admin pass).
#
#   cp .env.example .env

# --- permissions -----------------------------------------------------------
# Run the container as your host user so files in ./data stay yours (not root).
# Find yours:  id -u   /   id -g
COPYSYNC_UID=1000
COPYSYNC_GID=1000

# --- where state lives -----------------------------------------------------
# Host folder for the bbolt db + blobs + TLS key/pin. This IS the server's
# identity — back it up / move it to migrate the whole server. Keep it private
# (the TLS private key is in here): chmod 700.
COPYSYNC_DATA=./data

# --- network ---------------------------------------------------------------
# Host port to publish (the container always listens on 8443 internally).
COPYSYNC_PORT=8443

# --- server ----------------------------------------------------------------
COPYSYNC_SERVER_NAME=CopySync
COPYSYNC_ADMIN_USER=admin
# Seed password — you are FORCED to change it on first admin login. Change this
# (or just rely on the forced change) and never commit your real .env.
COPYSYNC_ADMIN_PASS=changeme

# Optional API key for programmatic admin access (automation/CI/debugging).
# When set (>=24 chars) the admin API also accepts `Authorization: Bearer <key>`
# or `X-API-Key: <key>`. This is a FULL-ACCESS admin credential — generate a
# strong random value and keep it secret (never commit your real .env):
#   openssl rand -base64 32
# Leave empty/unset to disable API-key auth entirely.
#COPYSYNC_API_KEY=

# Extra TLS SANs so LAN clients can pin & connect by IP/hostname (comma-sep).
# Auto-detected LAN IPs + localhost are always included.
#COPYSYNC_TLS_HOSTS=192.168.1.10,copysync.local
