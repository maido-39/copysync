# Go build output (binaries only — anchored so they don't match cmd/ source dirs)
/server/copysyncd
/server/copyctl
*.test
*.out
coverage*.out

# Local runtime state (bbolt db, self-signed certs, blobs).
# NOTE: anchored to the repo root only — a bare `**/data/` also matches source
# packages like clients/android/.../data/, so do not re-add it.
/data/
/server/data/
*.db

# Android / Gradle
/clients/android/.gradle/
**/build/
**/.kotlin/
/clients/android/local.properties
/clients/android/captures/
*.apk
*.keystore

# Rust / Tauri (desktop) build output
**/target/
/clients/desktop/src-tauri/gen/

# Local-only: staged install artifacts + running test-server state (NEVER commit; key.pem!)
/dist/
/livedata/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Synology NAS metadata
@eaDir/
**/@eaDir/
